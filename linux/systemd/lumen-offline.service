[Unit]
Description=Lumen optional local AI engine
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/opt/lumen-ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=%h/.local/share/lumen-os/models
Environment=OLLAMA_NO_CLOUD=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1
UMask=0077
NoNewPrivileges=true
MemoryMax=4G
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
